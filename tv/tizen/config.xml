<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://archivewatch.org/ArchiveWatch"
        version="1.3.284"
        viewmodes="maximized">

  <tizen:application id="ArchvWatch.ArchiveWatch"
                     package="ArchvWatch"
                     required_version="6.0"/>

  <name>Archive Watch</name>
  <description>A cinematheque for the Internet Archive — public-domain feature films, classic TV, silent cinema, animation and newsreels. Free, no account.</description>
  <author href="https://archivewatch.org" email="ben@learningischange.com">Ben Wilkoff</author>

  <content src="index.html"/>
  <icon src="icon.png"/>

  <!-- 1920x1080 is the design baseline (docs/TV-DESIGN.md §4.1). -->
  <tizen:profile name="tv"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 hwkey-event="enable"/>

  <!-- Playback streams progressive H.264 MP4 over HTTPS straight from
       archive.org, and artwork/catalog come from archivewatch.org. No DRM,
       no transcode (Decision 047). -->
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>archivewatch.org *.archivewatch.org archive.org *.archive.org image.tmdb.org</tizen:allow-navigation>

  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
</widget>
