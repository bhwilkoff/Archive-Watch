 "reviews": [
  {
   "store": "App Store",
   "id": "00000193-ec32-3f03-6194-164300000000",
   "rating": 5,
   "title": "I’ve always wanted this!",
   "body": "Works really well. Interface is intuitive and the feature set is absolutely bonkers. Curated channels? Random modes? A clip editor for sharing? Direct link to donate and support archive.org?? Unreal!! I’ve been wanting to make something like this for a long time. Before attempting to tackle this with AI (I have a life outside development lol) I figured I’d search again for something someone already made, and here it is. Thank you.",
   "author": "Denzel_Denzel",
   "territory": "USA",
   "date": "2026-09-07T09:22:24-07:00",
   "responded": true,
   "url": "https://appstoreconnect.apple.com/apps/6776697407/distribution/reviews"
  },
  {
   "store": "App Store",
   "id": "00000193-ec32-3f03-60ac-36fd00000000",
   "rating": 5,
   "title": "A perfect way to explore vintage videos",
   "body": "Having an interface to browse internet archive videos via Apple TV is amazing. There is so much content to check out.",
