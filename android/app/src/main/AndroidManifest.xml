<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- TV form factor (docs/TV-DESIGN.md §6.2/§6.3, Decision 047).
         required="false" throughout is what keeps ONE app + ONE AAB shipping
         to phones, tablets AND TV — never fork the app for TV.
         TV-MT: a TV has no touchscreen, so declaring it required would make
         the app invisible on every TV device. The rest are hardware a TV
         genuinely lacks; any one of them left implicitly-required excludes us
         from the TV form factor. -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.faketouch" android:required="false"/>
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>
    <uses-feature android:name="android.hardware.location" android:required="false"/>
    <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false"/>
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false"/>
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false"/>

    <application
        android:name=".app.ArchiveWatchApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ArchiveWatch.Splash"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.ArchiveWatch.Splash"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.shortcuts"
                       android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- TV-ML: without LEANBACK_LAUNCHER the app is INVISIBLE in the
                     Android TV / Google TV / Fire TV launcher even when
                     installed. Same activity as the phone launcher — the TV UI
                     is a runtime branch on UiModeManager, not a second entry
                     point (docs/TV-DESIGN.md §6.5). -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>

            <!-- archivewatch://item/{id} — same scheme as tvOS/iOS. The
                 surprise/channels hosts are handled by MainActivity (App
                 Shortcuts deliver them explicitly) but must also be declared
                 here or external VIEW intents to them fail to resolve. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="archivewatch" android:host="item"/>
                <data android:host="surprise"/>
                <data android:host="channels"/>
                <data android:host="series"/>
            </intent-filter>

            <!-- Verified App Links: archivewatch.org share URLs open the app
                 directly (assetlinks.json at the site's /.well-known). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="archivewatch.org"/>
                <data android:pathPrefix="/item/"/>
                <data android:pathPrefix="/series/"/>
            </intent-filter>
        </activity>

        <!-- Share exported Clip Studio clips via ACTION_SEND (FileProvider
             grants the receiving app temporary read on the cached file). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Home-screen widgets (the iOS WidgetKit suite's analogue). -->
        <receiver
            android:name="app.archivewatch.android.widgets.ContinueWatchingWidgetReceiver"
            android:exported="true"
            android:label="Continue Watching">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_continue" />
        </receiver>
        <receiver
            android:name="app.archivewatch.android.widgets.PickOfDayWidgetReceiver"
            android:exported="true"
            android:label="Pick of the Day">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pick" />
        </receiver>
        <receiver
            android:name="app.archivewatch.android.widgets.SurpriseWidgetReceiver"
            android:exported="true"
            android:label="Surprise Me">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_surprise" />
        </receiver>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>

</manifest>
