<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".app.ArchiveWatchApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.ArchiveWatch.Splash"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.ArchiveWatch.Splash"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.shortcuts"
                       android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- archivewatch://item/{id} — same scheme as tvOS/iOS. The
                 surprise/channels hosts are handled by MainActivity (App
                 Shortcuts deliver them explicitly) but must also be declared
                 here or external VIEW intents to them fail to resolve. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="archivewatch" android:host="item"/>
                <data android:host="surprise"/>
                <data android:host="channels"/>
            </intent-filter>

            <!-- Verified App Links: archivewatch.org share URLs open the app
                 directly (assetlinks.json at the site's /.well-known). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="archivewatch.org"/>
                <data android:pathPrefix="/item/"/>
                <data android:pathPrefix="/series/"/>
            </intent-filter>
        </activity>

        <!-- Share exported Clip Studio clips via ACTION_SEND (FileProvider
             grants the receiving app temporary read on the cached file). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>

</manifest>
