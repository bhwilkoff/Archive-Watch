<?xml version="1.0" encoding="utf-8"?>
<!--
  google-flavor manifest additions (Decision 047 §6.6).

  This exists ONLY to point the Cast SDK at CastOptionsProvider. It is merged
  into the main manifest for the google flavor and is absent from the amazon
  flavor, which links no GMS at all — see
  android/app/src/amazon/java/.../cast/CastSupport.kt and
  tools/audit_fire_tv_gms.py.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      THE HOST'S CAMERA AND VOICE, google flavour ONLY.

      Watch Together Studio is a google-flavour feature (Decision 129): the
      amazon flavour is Fire TV, which has neither a camera nor a microphone,
      and a permission a build can never use is one an installer is asked to
      grant for nothing. Declaring them here keeps them out of that build
      entirely rather than relying on a runtime check.

      `uses-feature required="false"` for both is already in the main
      manifest, so a television still installs — it simply never asks.

      Until 2026-09-20 neither permission existed on any flavour and the app
      declared only INTERNET, which is why Android's Studio could broadcast a
      film and could not carry the host at all (WATCH-TOGETHER §9.qqqqq).
    -->
    <!-- camera: uses-feature required="false" is in the main manifest -->
    <uses-permission android:name="android.permission.CAMERA"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Android 17: Cast devices on the LAN reach the app's route list only
         with this runtime permission (measured 2026-09-29: Play services heard
         the receivers, and the app got no routes until it held it). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>

    <!-- A live show keeps its camera and microphone when the host locks the
         phone or switches apps (launch audit A15, StudioBroadcastService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application>
        <service
            android:name="app.archivewatch.android.studio.StudioBroadcastService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="app.archivewatch.android.cast.CastOptionsProvider" />
        <!-- Lets Android 13+ open the SYSTEM output switcher from the Cast icon
             (CastOptions.setShowSystemOutputSwitcherOnCastIconClick); without it
             mediarouter falls back to its in-app chooser. -->
        <receiver
            android:name="androidx.mediarouter.media.MediaTransferReceiver"
            android:exported="true" />
    </application>
</manifest>
