# Archive Watch — Roku channel manifest.
# Published to the Channel Store (channel 881015). The store's minimum firmware
# is v5.0.2, so nothing in Roku's policy excludes an old player — what excluded
# them was OUR code: 1.0.51 shipped 34 uses of `continue for`, which firmware
# below ~OS 11 cannot PARSE, so those components failed to compile on a Roku 2
# XD rather than merely running slowly. Verified on that device at 1.0.65:
# AWTIER legacy, overscan inset applied, 29 home rows, no backtrace.
title=Archive Watch
major_version=1
minor_version=0
build_version=00079

mm_icon_focus_fhd=pkg:/images/icon_focus_fhd.png
mm_icon_focus_hd=pkg:/images/icon_focus_hd.png
mm_icon_focus_sd=pkg:/images/icon_focus_sd.png

splash_screen_sd=pkg:/images/splash_sd.png
splash_screen_hd=pkg:/images/splash_hd.png
splash_screen_fhd=pkg:/images/splash_fhd.png
splash_color=#0A0A0A
splash_min_time=800

# The Streaming Stick 4K reports a 1080p UI; design at 1920x1080 and let Roku
# scale down for 720p panels rather than authoring two grids.
ui_resolutions=fhd

# rsg_version=1.3 is required: since 2026-10-01 Roku's certification refuses a
# package without it (static analysis reports an ERROR, not a warning) and
# offers no minimum firmware below 15.1. A Roku on older firmware keeps the
# last package it could run (1.0.77, floor 8.0) and gets no further updates.
rsg_version=1.3
supports_input_launch=1
