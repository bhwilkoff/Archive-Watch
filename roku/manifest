# Archive Watch — Roku channel manifest.
# Sideload only for now (owner decision 2026-09-03): the Channel Store needs a
# signing key and certification, and that is a separate decision from parity.
title=Archive Watch
major_version=1
minor_version=0
build_version=00060

mm_icon_focus_fhd=pkg:/images/icon_focus_fhd.png
mm_icon_focus_hd=pkg:/images/icon_focus_hd.png
mm_icon_focus_sd=pkg:/images/icon_focus_sd.png

splash_screen_sd=pkg:/images/splash_sd.png
splash_screen_hd=pkg:/images/splash_hd.png
splash_screen_fhd=pkg:/images/splash_fhd.png
splash_color=#0A0A0A
splash_min_time=800

# The Streaming Stick 4K reports a 1080p UI; design at 1920x1080 and let Roku
# scale down for 720p panels rather than authoring two grids.
ui_resolutions=fhd

# NOT rsg_version=1.3, deliberately. Static analysis warns twice about its
# absence, and taking the warning would cost far more than it buys: RSG 1.3
# requires a MINIMUM FIRMWARE of 15.1, which locks the channel out of every
# older Roku — including the Roku 2 XD on this account. Nothing here needs
# the 1.3 runtime. An archive of public-domain film is exactly the app that
# should run on the cheap old box somebody already owns, so the two warnings
# stay and the firmware floor stays low.
supports_input_launch=1
