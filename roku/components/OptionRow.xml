<?xml version="1.0" encoding="utf-8" ?>
<!-- One row of an OptionsList: a 60 px pill (§13.5) that lights on focus, with
     the label inset from its end cap. A LabelList cannot inset its text or size
     its pill below the row, which is why the panel rows are drawn here. -->
<component name="OptionRow" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
    <!-- EntryPanel's buttons sit beside a keyboard: a list keeps its focused
         row lit after focus leaves it, and only one thing may be lit. -->
    <field id="listHasFocus" type="boolean" value="true" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Capability.brs" />
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/OptionRow.brs" />
  <children>
    <Poster id="pill" />
    <Label id="label" />
  </children>
</component>
