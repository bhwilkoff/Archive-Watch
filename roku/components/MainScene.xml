<?xml version="1.0" encoding="utf-8" ?>
<!-- The shell. ROKU-DESIGN §2: an Overhang, a LEFT rail, and a content column.
     Settings is not a surface (§2.3) and Surprise is not a surface (§2.4). -->
<component name="MainScene" extends="Scene">
  <interface>
    <!-- Roku's deep-link contract: contentId names the film, mediaType says
         what it is. A launch or an roInput message while running both land
         here. -->
    <field id="deepLinkContentId" type="string" alwaysNotify="true" onChange="onDeepLink" />
    <field id="deepLinkMediaType" type="string" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/UserStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/LayoutAudit.brs" />
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0B0B0CFF" />


    <Group id="content" />
    <Group id="overlay" />

    <!-- No overhang. The brand bar, the clock and a bare "(*)" were three
         permanent elements that told the viewer nothing they did not already
         know — the owner's question "what is the (*) in the corner?" is the
         whole argument. Roku's own channels do not carry a persistent title
         bar, every surface already names itself, and removing it gives the
         hero its full 115px back. -->

    <NavRail id="rail" />

    <Label id="loading" />

    <!-- Last child: the options overlay dims and covers EVERYTHING, rail
         included, or it reads as a panel the page is still competing with. -->
    <Group id="options" />
  </children>
</component>
