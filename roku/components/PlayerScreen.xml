<?xml version="1.0" encoding="utf-8" ?>
<!-- ROKU-DESIGN §6.6 — the Video node owns the transport. We recolour the
     trick bar and change nothing structural, which Decision 037 already asked
     for and Roku enforces anyway.

     §6.6b — there is NO resilient loader here and there cannot be: the Video
     node's HTTP client lives in firmware. What survives is redirect pinning,
     transient-error tolerance, and the stagnation watchdog below. -->
<component name="PlayerScreen" extends="Group">
  <interface>
    <field id="playUrl" type="string" onChange="onUrl" />
    <field id="playTitle" type="string" />
    <field id="playMeta" type="string" />
    <!-- The series an episode belongs to, so Continue Watching can borrow the
         spine's poster: an episode carries none of its own. -->
    <field id="progressOwner" type="string" />
    <!-- Trick-play thumbnails (Roku BIF). Empty for every film today; set by
         a harness door so a generated file can be measured on the device. -->
    <field id="bifUrl" type="string" />
    <field id="archiveID" type="string" />
    <field id="startAt" type="integer" value="0" />
    <field id="captionUrl" type="string" />
    <!-- Party Play is muted colour visuals for a room (tvOS startMuted).
         Written at launch AND toggled mid-film by the player options list. -->
    <field id="muted" type="boolean" value="false" onChange="onMuted" />
    <!-- An ephemeral lineup (Party Play, a channel): a wall of films the
         viewer did not choose. It raises "what IS this?" and "keep this", so
         Up opens an options list (ROKU-DESIGN §6.9). `currentID` is the film
         playing whether or not a bookmark is being written — `archiveID` is
         blank for an ephemeral lineup on purpose, so it cannot serve. -->
    <field id="ephemeral" type="boolean" value="false" />
    <field id="currentID" type="string" />
    <field id="menuRequested" type="boolean" alwaysNotify="true" />
    <field id="ended" type="boolean" alwaysNotify="true" />
    <!-- A failure the VIEWER has to be told about, not just a console line. -->
    <field id="failed" type="string" alwaysNotify="true" />
    <!-- A Watch Together room to FOLLOW (SHAREPLAY §11). Set after playUrl;
         "" stops following. The host controls the film. -->
    <field id="roomCode" type="string" onChange="onRoomCode" />
    <function name="stopPlayback" />
    <!-- "Remember this film": the Watched row is the record on Roku. -->
    <function name="rememberFilm" />
    <function name="showNotice" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Capability.brs" />
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
    <script type="text/brightscript" uri="pkg:/components/UserStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/PlayerScreen.brs" />
  <children>
    <Video id="video" />
    <Rectangle id="hudScrim" />
    <Label id="hudTitle" />
    <Label id="hudMeta" />
    <Label id="diag" />
    <Timer id="watchdog" repeat="true" duration="5" />
    <Timer id="roomTick" repeat="true" duration="1" />
  </children>
</component>
