<?xml version="1.0" encoding="utf-8" ?>
<!-- ROKU-DESIGN §6.5 — art, title, "Also known as", meta, a capped synopsis,
     then a horizontal button row with Play AUTO-FOCUSED and labelled with the
     runtime. Depth stays at 2 (§2.5): this is the item, not a stack. -->
<component name="DetailScreen" extends="Group">
  <interface>
    <field id="item" type="node" onChange="onItem" />
    <field id="detail" type="assocarray" onChange="onDetail" />
    <field id="focusOn" type="boolean" onChange="onFocusOn" />
    <field id="play" type="string" alwaysNotify="true" />
    <field id="playFrom" type="integer" value="0" />
    <!-- First English caption track for this film, if the catalog has one. -->
    <field id="captionUrl" type="string" />
    <!-- Raised when the More button is pressed; the Scene owns the overlay. -->
    <field id="showMore" type="boolean" alwaysNotify="true" />
    <field id="runtimeSeconds" type="integer" value="0" />
    <!-- Raised when Detail wants its "more like this" row filled. -->
    <field id="wantLike" type="assocarray" alwaysNotify="true" />
    <field id="chosen" type="string" alwaysNotify="true" />
    <!-- F7 — Left from the first pill hands focus to the rail (§2.1), as every other screen. -->
    <field id="exitLeft" type="boolean" alwaysNotify="true" />
    <function name="showLike" />
    <!-- F12 — the synopsis is read from the More menu, never by a Down stop. -->
    <function name="synopsisCut" />
    <function name="readSynopsis" />
    <field id="toast" type="string" alwaysNotify="true" onChange="onToast" />
    <function name="refresh" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/UserStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/DetailScreen.brs" />
  <children>
    <!-- §13.7 — a SCENE: backdrop full-bleed across the top, the tvOS
         gradient over it, the poster inset over the seam, copy to its right.
         With no backdrop the field carries the category accent. -->
    <!-- §13.7 (revised 2026-09-04): a soft AMBIENT base decoded tiny and
         scaled up — a real blur, since SceneGraph has no shader — so a poster
         forced into a 3.19:1 band is never a hard cropped/pixelated image.
         The sharp `wash` (a true 16:9 backdrop) rides on top of it when one
         exists; poster-only titles show only the blur. -->
    <!-- F12 — everything that SCROLLS lives in one Group, as on Home: Down
         into More Like This slides the scene up so the shelf sits where the
         title was, the tvOS "scroll down the detail page" made of the nodes
         Roku has. The toast stays fixed over it. -->
    <Group id="page">
    <Poster id="washBlur" />
    <Poster id="wash" />
    <Rectangle id="field" visible="false" />
    <!-- The copy sits on the LEFT of the scene, so the scene is darkened on
         the left and left alone on the right — the ten-foot idiom. A flat
         scrim strong enough for the copy dims the whole picture. -->
    <Poster id="fadeH" />
    <Poster id="fade" />
    <Rectangle id="scrim" visible="false" />
    <Poster id="art" />
    <Group id="artFrame" />
    <Label id="kind" />
    <Label id="title" />
    <Label id="aka" />
    <Label id="meta" />
    <Label id="synopsis" />
    <Rectangle id="chip" />
    <Label id="chipText" />
    <Group id="buttons" />
    <Label id="cast" />
    <Label id="likeLabel" visible="false" />
    <RowList id="like" visible="false" />
    <!-- F4 — what archive.org's own viewers made of this film: the stats
         line and their reviews, below More Like This on the scrolling page
         (the tvOS CommunityDetailSection). -->
    <Group id="community" visible="false" />
    </Group>
    <Animation id="pageAnim" duration="0.3" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="pageInterp" key="[0.0,1.0]" fieldToInterp="page.translation" />
    </Animation>
    <Timer id="toastTimer" duration="10" repeat="false" />
    <!-- LAST, so it draws over the shelf below it. Declared earlier, the
         "more like this" row covered it completely and the message was
         invisible while the code was doing everything right. -->
    <Rectangle id="toastPlate" visible="false" />
    <Label id="toastText" visible="false" />
  </children>
</component>
