<?xml version="1.0" encoding="utf-8" ?>
<!-- ROKU-DESIGN §6.11 — a series. Season list beside its episodes, the same
     two-column shape the Channels guide uses, because a Roku remote navigates
     two vertical lists far better than it navigates a grid of seasons. -->
<component name="SeriesScreen" extends="Group">
  <interface>
    <field id="focusOn" type="boolean" onChange="onFocusOn" />
    <field id="playEpisode" type="assocarray" alwaysNotify="true" />
    <field id="exitLeft" type="boolean" alwaysNotify="true" />
    <field id="seriesID" type="string" />
    <function name="showSeries" />
    <function name="refreshProgress" />
    <function name="showNotice" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/UserStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/SeriesScreen.brs" />
  <children>
    <!-- §13.7 — the same scene as Detail: backdrop across the top under the
         gradient, the spine's poster inset over the seam, copy to its right,
         seasons and episodes below the seam. -->
    <Poster id="wash" />
    <!-- F27/F29 — the designed accent field for a series with no real
         backdrop. A poster zoomed across this band is a crop, not a scene. -->
    <Rectangle id="field" visible="false" />
    <Poster id="fade" />
    <Rectangle id="scrim" visible="false" />
    <Poster id="art" />
    <Group id="artFrame" />
    <Label id="kind" />
    <Label id="title" />
    <Label id="meta" />
    <Label id="overview" />
    <LabelList id="seasons" />
    <MarkupList id="episodes" />
    <Label id="empty" visible="false" />
  </children>
</component>
