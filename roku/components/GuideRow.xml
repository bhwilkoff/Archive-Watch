<?xml version="1.0" encoding="utf-8" ?>
<!-- One programme in the guide: when it starts, what it is, and whether it is
     on RIGHT NOW. The now marker is the only coloured thing in the list, so it
     reads at ten feet without anyone hunting for it. -->
<component name="GuideRow" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/GuideRow.brs" />
  <children>
    <Label id="time" />
    <Label id="title" />
    <Rectangle id="nowChip" visible="false" />
    <Label id="nowText" visible="false" />
  </children>
</component>
