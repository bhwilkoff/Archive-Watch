<?xml version="1.0" encoding="utf-8" ?>
<component name="EpisodeRow" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/UserStore.brs" />
  <script type="text/brightscript" uri="pkg:/components/EpisodeRow.brs" />
  <children>
    <!-- The still, and behind it a typographic card for the majority of this
         catalog's spines, which publish no episode art at all. A blank left
         third reads as a broken row. -->
    <Rectangle id="card" />
    <Label id="cardText" />
    <Poster id="still" />
    <Group id="stillFrame" />
    <Label id="num" />
    <Label id="title" />
    <Label id="blurb" />
    <Rectangle id="bar" visible="false" />
  </children>
</component>
