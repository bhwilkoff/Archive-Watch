<?xml version="1.0" encoding="utf-8" ?>
<!-- Fetches the published schedule (channel-schedule.json): one UTC timeline
     per channel, the same on every platform (ROKU-DESIGN 6.7). The pools file
     is read only for commercials and the Cartoon Marathon. -->
<component name="ChannelsTask" extends="Task">
  <interface>
    <field id="status" type="string" alwaysNotify="true" />
    <field id="channels" type="assocarray" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Capability.brs" />
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/Sched.brs" />
  <script type="text/brightscript" uri="pkg:/components/ChannelsTask.brs" />
</component>
