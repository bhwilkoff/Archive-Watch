<?xml version="1.0" encoding="utf-8" ?>
<!-- ROKU-DESIGN §6.12 — the random actions.
     §2.4 said Surprise was an ACTION and did not deserve a rail slot. That was
     written when there was one of it. With eleven distinct doors it IS a
     surface, and tvOS has treated it as one since Decision 014 — so the rail
     goes to eight and the doc is amended rather than the feature bent to fit
     an old rule. -->
<component name="SurpriseScreen" extends="Group">
  <interface>
    <field id="focusOn" type="boolean" onChange="onFocusOn" />
    <field id="action" type="string" alwaysNotify="true" />
    <field id="exitLeft" type="boolean" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/SurpriseScreen.brs" />
  <children>
    <Label id="heading" />
    <Label id="hint" />
    <MarkupGrid id="grid" />
  </children>
</component>
