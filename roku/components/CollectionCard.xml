<?xml version="1.0" encoding="utf-8" ?>
<!-- F16 / ROKU-DESIGN §6.8 (amended) — one curated collection as a CARD: a
     three-poster composite under the §13.3 gradient, an accent rule, the
     count, the title in the display face and the blurb. The tvOS
     CollectionsView card, built from the nodes Roku has. -->
<component name="CollectionCard" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/CollectionCard.brs" />
  <children>
    <Rectangle id="plate" />
    <Poster id="p0" />
    <Poster id="p1" />
    <Poster id="p2" />
    <Poster id="fade" />
    <Rectangle id="rule" />
    <Label id="count" />
    <Label id="title" />
    <Label id="blurb" />
    <Group id="frame" />
  </children>
</component>
