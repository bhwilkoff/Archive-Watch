<?xml version="1.0" encoding="utf-8" ?>
<!-- ROKU-DESIGN §6.1 — Home is a hero row over shelves, in the shared shelf
     order every other platform uses, so the curation cannot drift. -->
<component name="HomeScreen" extends="Group">
  <interface>
    <field id="rowsContent" type="node" onChange="onRows" />
    <field id="heroContent" type="node" onChange="onHero" />
    <field id="focusOn" type="boolean" onChange="onFocusOn" />
    <field id="onScreen" type="boolean" onChange="onOnScreen" />
    <field id="exitLeft" type="boolean" alwaysNotify="true" />
    <field id="chosen" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/Theme.brs" />
  <script type="text/brightscript" uri="pkg:/components/HomeScreen.brs" />
  <children>
    <!-- Everything that scrolls lives in one Group so the hero can SLIDE AWAY
         when the viewer moves down into the shelves, the way it does on tvOS.
         The hero is not a permanent band. -->
    <Group id="scroll">
      <!-- Hero. Decision 097 binds: the art renders at its OWN aspect over an
           ambient wash of itself, never cropped into a wide box. -->
      <Poster id="heroWash" />
      <Rectangle id="heroScrim" />
      <Poster id="heroArt" />
      <!-- Roku has no gradient node. Sixteen stacked Rectangles was the
           workaround and it BANDED: the owner saw "line artifacts all over
           the poster". These are real gradient PNGs, authored at display
           size, and they scale without seams. -->
      <Poster id="heroFade" />
      <Poster id="heroFloor" />
      <!-- tvOS leads the hero copy with a category label in the category
           accent. -->
      <Label id="heroKind" />
      <Label id="heroTitle" />
      <Label id="heroMeta" />
      <!-- The focus ring for the hero itself: a hero the viewer can act on has
           to LOOK actionable, and Roku draws no ring for a Group. -->
      <Rectangle id="heroRingT" />
      <Rectangle id="heroRingB" />
      <Rectangle id="heroRingL" />
      <Rectangle id="heroRingR" />
      <Label id="heroHint" />
      <Group id="heroDots" />

      <RowList id="rows" />
    </Group>
    <Timer id="heroTimer" duration="9" repeat="true" />
    <!-- Holding Right through a 12-title pool must not queue twelve backdrop
         downloads. The copy changes on the press; the ART settles after. -->
    <Timer id="heroArtTimer" duration="0.25" repeat="false" />
    <Animation id="scrollAnim" duration="0.25" easeFunction="outQuad">
      <Vector2DFieldInterpolator id="scrollInterp" key="[0.0,1.0]" fieldToInterp="scroll.translation" />
    </Animation>
  </children>
</component>
