// Copy this file to `Secrets.xcconfig` and fill in your keys. The real file
// is gitignored. Xcode reads it via the tvOS target's Debug + Release
// configurations. Python enrichment scripts (`tools/enrich_artwork.py`)
// read the same file via tools/enrich_artwork.py:load_secret().

// TMDb v4 bearer token (primary metadata + artwork source).
// Register at https://www.themoviedb.org/settings/api (v4 → "API Read Access Token").
TMDB_BEARER_TOKEN = your-tmdb-v4-bearer-token-here

// Fanart.tv personal API key (gap-fills designed movie posters when TMDb
// doesn't have one). Register at https://fanart.tv/get-an-api-key.
// Optional — enrichment skips this pass cleanly if the key is missing.
FANART_TV_KEY = your-fanart-tv-key-here

// OMDb API key (another IMDb-keyed designed-poster source — Amazon-hosted
// promotional art). Register at https://www.omdbapi.com/apikey.aspx.
// Free tier: 1000 req/day. Optional — skipped cleanly if missing.
OMDB_KEY = your-omdb-key-here

// ---------------------------------------------------------------------------
// Watch Together Studio (docs/WATCH-TOGETHER.md §6) — streaming a
// public-domain film to the HOST'S OWN YouTube or Twitch channel.
//
// These are PUBLIC OAuth client ids, not secrets. They live here anyway,
// because they identify a particular registered application and a fork should
// register its own. Neither flow uses a client SECRET, so there is nothing
// here that could leak a credential: Google uses the authorization-code flow
// with PKCE, and Twitch uses its device flow (Twitch does not support PKCE).
//
// Both are OPTIONAL. Absent, the go-live sheet says sign-in is not set up in
// this build and greys out Go Live, rather than offering a button that fails.
//
// YOUTUBE_CLIENT_ID — console.cloud.google.com
//   1. Create a project, enable "YouTube Data API v3".
//   2. OAuth consent screen: External. While it is in "Testing" only accounts
//      you add as test users can sign in — add your own.
//   3. Credentials → Create credentials → OAuth client ID → iOS.
//      Bundle ID: app.archivewatch.tvos   (the redirect scheme is the bundle
//      id, already declared in ArchiveWatch/Info.plist — nothing to paste.)
//   4. Paste the client id below.
//   Note: YouTube requires a channel to be ENABLED for live streaming, which
//   is a one-time step on youtube.com and can take 24 hours the first time.
//
// TWITCH_CLIENT_ID — dev.twitch.tv/console/apps
//   1. Register Your Application. Category: any.
//   2. Client Type: PUBLIC. OAuth Redirect URL: http://localhost (unused —
//      the device flow needs no redirect, but the form requires a value).
//   3. Paste the Client ID below. Do NOT generate a client secret.
// ---------------------------------------------------------------------------
YOUTUBE_CLIENT_ID = your-google-oauth-client-id.apps.googleusercontent.com

// YOUTUBE_TV_CLIENT_ID / YOUTUBE_TV_CLIENT_SECRET — OPTIONAL. LEAVE BLANK.
//
// Apple TV does NOT need them. Its YouTube sign-in uses the YOUTUBE_CLIENT_ID
// above through ASWebAuthenticationSession, which on tvOS hands off to the
// host's nearby iPhone ("Sign in with Apple Device"); the phone does the
// Google sign-in and the token lands on the television (measured 2026-09-18,
// Decision 128's correction in SCRATCHPAD).
//
// Filled in, they switch Apple TV to Google's device flow instead (a QR and a
// short code). Google allows that flow only to a client of type "TVs and
// Limited Input devices", which issues an id AND a secret — the one secret in
// this app. Both must be REAL values or both empty: any non-empty text counts
// as configured, so a placeholder left here would select the device flow with
// a client that does not exist.
YOUTUBE_TV_CLIENT_ID =
YOUTUBE_TV_CLIENT_SECRET =
TWITCH_CLIENT_ID = your-twitch-application-client-id
