// Shared version numbers — edit here to update all targets at once.
// Do NOT edit MARKETING_VERSION or CURRENT_PROJECT_VERSION via the
// Xcode identity panel; that creates a per-target override that shadows
// this file and causes targets to drift apart again.

// Versioning convention (Claude manages this per change set):
//   MARKETING_VERSION       — user-facing, three-part major.minor.PATCH; bump the
//                             PATCH +1 each change set (1.0.1 -> 1.0.2 -> ...).
//                             Slow march to 2.0; Apple preserves this format
//                             exactly (no leading-zero normalization).
//   CURRENT_PROJECT_VERSION — build number; integer, bumped so every App Store
//                             upload is unique/monotonic.
MARKETING_VERSION = 1.3.0
CURRENT_PROJECT_VERSION = 46

// Optional per-developer secrets (gitignored). The `?` makes it optional so
// the project still builds on machines where Secrets.xcconfig is absent.
#include? "Secrets.xcconfig"
