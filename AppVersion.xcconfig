// Shared version numbers — edit here to update all targets at once.
// Do NOT edit MARKETING_VERSION or CURRENT_PROJECT_VERSION via the
// Xcode identity panel; that creates a per-target override that shadows
// this file and causes targets to drift apart again.

// Versioning convention — Claude bumps BOTH on EVERY commit (Xcode Cloud uses
// these committed values directly; it does NOT auto-manage them):
//   MARKETING_VERSION       — CFBundleShortVersionString, three-part major.minor.PATCH.
//                             Bump PATCH +1 every commit. Bump MINOR (PATCH to 0) only when
//                             a release carries something a user would call NEW since the
//                             last released version; a fix-only release keeps its minor.
//                             A store upload never bumps the minor on its own account (owner,
//                             2026-09-30: "we shouldn't be pushing a new minor release for each
//                             new version ... in a way that makes sense each time"). An
//                             already-approved train is
//                             "closed" (ITMS-90186/90062), so the version must always
//                             stay ahead of the last upload — bumping each commit keeps it so.
//                             Apple preserves the format exactly (no leading-zero normalization).
//   CURRENT_PROJECT_VERSION — CFBundleVersion build number, integer. Bump +1 every commit
//                             so every archive/TestFlight upload is unique + monotonic.
// All targets (app + widgets + top shelf) inherit both via the project base configuration.
MARKETING_VERSION = 1.44.1
CURRENT_PROJECT_VERSION = 2083

// Optional per-developer secrets (gitignored). The `?` makes it optional so
// the project still builds on machines where Secrets.xcconfig is absent.
#include? "Secrets.xcconfig"
