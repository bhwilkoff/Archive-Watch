<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Complete macOS Info.plist (GENERATE_INFOPLIST_FILE = NO). Like the universal
  Info.plist, bundle id / version / TMDb token stay driven by build-setting
  variables so nothing drifts from AppVersion.xcconfig / Secrets.xcconfig.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Archive Watch</string>
	<key>CFBundleDisplayName</key>
	<string>Archive Watch</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.entertainment</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Ben Wilkoff. Video hosted by the Internet Archive.</string>
	<!-- Export compliance: only standard, exempt encryption (HTTPS/TLS to public
	     APIs + Apple's CloudKit / Sign in with Apple). Auto-answers the App Store
	     Connect export question for every build. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>TMDB_BEARER_TOKEN</key>
	<string>$(TMDB_BEARER_TOKEN)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.archivewatch.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>archivewatch</string>
			</array>
		</dict>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.bhwilkoff.archivewatch.viewing</string>
	</array>
	<!-- Creation Studio `.archiveproj` document type (docs/macOS-DESIGN.md §2). An
	     exported PACKAGE type (a directory bundle, Rule 2b) holding the timeline JSON +
	     project-local imports — never archive.org bytes. Must match
	     UTType(exportedAs: "org.archivewatch.project"). -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.archivewatch.project</string>
			<key>UTTypeDescription</key>
			<string>Archive Watch Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>archiveproj</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Archive Watch Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.archivewatch.project</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
