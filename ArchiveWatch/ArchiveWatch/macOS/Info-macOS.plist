<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Archive Watch</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Archive Watch Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.archivewatch.project</string>
			</array>
			<key>LSTypeIsPackage</key>
			<true/>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Archive Watch</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.archivewatch.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>archivewatch</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.archivewatch.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app.archivewatch.tvos</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>TWITCH_CLIENT_ID</key>
	<string>$(TWITCH_CLIENT_ID)</string>
	<key>YOUTUBE_CLIENT_ID</key>
	<string>$(YOUTUBE_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.entertainment</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Ben Wilkoff. Video hosted by the Internet Archive.</string>
	<!-- A process tap (macOS-DESIGN §D2's fourth input) is gated by its OWN
	     TCC service, separate from the microphone: capturing what ANOTHER app
	     is playing is not the same permission as listening to a microphone,
	     and the entitlements below do not cover it. Without this key the
	     request is refused with no prompt, which reads as a silent channel. -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>Archive Watch captures the window of the call you are already on, so your guests can be seen in your broadcast. It captures only the window you pick.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Archive Watch mixes the audio of a call you are already on — Zoom, Meet, FaceTime — into your Watch Together broadcast, so your guests can be heard.</string>
	<key>NSCameraUsageDescription</key>
	<string>Show your reactions beside the film when you stream a public-domain movie with Watch Together Studio.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a voiceover narration for your Creation Studio edits.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.bhwilkoff.archivewatch.viewing</string>
	</array>
	<key>TMDB_BEARER_TOKEN</key>
	<string>$(TMDB_BEARER_TOKEN)</string>
	<key>OPENSUBTITLES_API_KEY</key>
	<string>$(OPENSUBTITLES_API_KEY)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeDescription</key>
			<string>Archive Watch Project</string>
			<key>UTTypeIdentifier</key>
			<string>org.archivewatch.project</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>archiveproj</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
