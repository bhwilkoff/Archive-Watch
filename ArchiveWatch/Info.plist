<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Complete Info.plist (GENERATE_INFOPLIST_FILE = NO). Bundle id, version,
  and the TMDb token stay driven by build-setting variables so nothing
  drifts from AppVersion.xcconfig / Secrets.xcconfig. The custom keys
  below can't be expressed as INFOPLIST_KEY_* settings:
    • CFBundleURLTypes     — archivewatch:// deep links (Top Shelf + intents)
    • NSUserActivityTypes  — Detail NSUserActivity / "Add to Up Next"
    • BGTaskSchedulerPermittedIdentifiers + UIBackgroundModes — What's New refresh
-->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <!-- Export compliance: the app uses only standard, exempt encryption (HTTPS/TLS
         to public APIs, plus Apple's own CloudKit / Sign in with Apple). Declaring
         this here auto-answers the App Store Connect export question for every
         build, so no manual compliance step per upload. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>TMDB_BEARER_TOKEN</key>
    <string>$(TMDB_BEARER_TOKEN)</string>
    <!-- Clip Studio (Decision 033, iOS/iPadOS): saving a finished clip/GIF to
         the user's library. Add-only is the lighter grant — the app never
         reads the photo library. tvOS has no Clip Studio so this is iOS-only,
         but the universal Info.plist carries it harmlessly. -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Save the clips and GIFs you create from public-domain films to your photo library.</string>
    <!-- Clip Studio auto-captions (Decision 033 v2): on-device speech
         recognition transcribes a clip's audio into timed captions. -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Transcribe a clip's audio on your device to add timed captions.</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.bhwilkoff.archivewatch.deeplink</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>archivewatch</string>
            </array>
        </dict>
    </array>
    <key>NSUserActivityTypes</key>
    <array>
        <string>com.bhwilkoff.archivewatch.viewing</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>com.bhwilkoff.archivewatch.refresh</string>
    </array>
    <key>UIBackgroundModes</key>
    <array>
        <!-- `audio` enables background play (iOS) and Picture in Picture
             (both platforms) — the player's .playback session keeps audio
             running when the app backgrounds. fetch/processing are the
             What's New refresh. -->
        <string>audio</string>
        <string>fetch</string>
        <string>processing</string>
    </array>
    <!-- iOS/iPadOS launch screen. WITHOUT this key iOS runs the app in
         compatibility "letterbox" mode at a fixed reference size (the content
         is squeezed into a centered box that uses only part of the screen).
         An empty dict gives a plain full-screen launch using the app window's
         background. tvOS ignores UILaunchScreen. -->
    <key>UILaunchScreen</key>
    <dict/>
    <!-- iPhone: portrait + landscape; iPad: all four. tvOS ignores these. -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
