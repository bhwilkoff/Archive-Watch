<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.bhwilkoff.archivewatch.refresh</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.bhwilkoff.archivewatch.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>archivewatch</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.archivewatch.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app.archivewatch.tvos</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>callsheet</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Show your reactions beside the film when you stream a public-domain movie with Watch Together Studio. On Apple TV, this uses a nearby iPhone as the camera.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Add your live commentary to a Watch Together Studio broadcast, and record narration for the clips you create.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save the clips and GIFs you create from public-domain films to your photo library.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Transcribe a clip's audio on your device to add timed captions.</string>
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.bhwilkoff.archivewatch.viewing</string>
	</array>
	<key>OPENSUBTITLES_API_KEY</key>
	<string>$(OPENSUBTITLES_API_KEY)</string>
	<key>TMDB_BEARER_TOKEN</key>
	<string>$(TMDB_BEARER_TOKEN)</string>
	<key>TWITCH_CLIENT_ID</key>
	<string>$(TWITCH_CLIENT_ID)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>YOUTUBE_CLIENT_ID</key>
	<string>$(YOUTUBE_CLIENT_ID)</string>
</dict>
</plist>
